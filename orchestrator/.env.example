# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# LiteLLM proxy (required — start with: docker compose up -d)
LITELLM_URL=http://127.0.0.1:4000

# PostgreSQL (required)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/yana

# Neo4j / Graphiti episodic memory (required — start with: docker compose up -d)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=
NEO4J_PASSWORD=

# Model aliases — must match names configured in your LiteLLM config
YANA_MODEL_CONVERSATION=bedrock-claude
YANA_MODEL_CONVERSATION_FAST=bedrock-claude-haiku
YANA_MODEL_FIRST_BREATH=bedrock-claude
YANA_MODEL_SANCTUM_WRITE=bedrock-claude-haiku
YANA_MODEL_PULSE_SCHEDULED=bedrock-claude-haiku
YANA_MODEL_PULSE_TRIGGERED=bedrock-claude-haiku
YANA_MODEL_MEMORY=bedrock-claude-haiku
YANA_MODEL_EMBED=bedrock-embed

# Voice (optional — defaults shown)
STT_PROVIDER=faster-whisper
STT_MODEL=tiny
STT_LANGUAGE=pt
TTS_VOICE=pt-BR-FranciscaNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
